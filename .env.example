# Application
ENVIRONMENT=development
API_PREFIX=/api/v1
SECRET_KEY=replace-with-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=postgresql+psycopg://codeguardian:codeguardian@postgres:5432/codeguardian
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# GitHub App or OAuth token. The product still runs in local-demo mode without it.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Optional LLM provider. Leave blank to use the deterministic explanation provider.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

